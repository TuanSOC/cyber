# Security headers shared by every response (CSP: see csp_fallback below).
(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
		-X-Powered-By
	}
}

# Prod only (TLS): HSTS, and COOP (browsers ignore COOP on non-HTTPS origins).
(hsts) {
	header Strict-Transport-Security "max-age=31536000"
	header Cross-Origin-Opener-Policy same-origin
}

# Content-Security-Policy is owned by the upstreams:
# - HTML pages: the web app (apps/web/proxy.ts) sets a per-request nonce policy; Caddy must not
#   replace it (a static policy cannot carry the nonce, so it would either allow inline scripts
#   or block Next.js's own).
# - API downloads: FastAPI sets `Content-Security-Policy: sandbox`.
# `?` only sets this fail-closed fallback when the upstream sent none: plain API/JSON responses,
# gateway-generated errors, static assets and prefetch payloads (none of which need to run
# anything). An HTML page that somehow lost the app policy renders inert instead of open.
(csp_fallback) {
	header ?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
}

(cyberlab_routes) {
	# Evidence upload is the only route allowed a large body; everything else is capped at 1 MB.
	@evidence_upload {
		method POST
		path_regexp ^/api/v1/orgs/[^/]+/investigations/[^/]+/evidence$
	}

	# max_size only trips when the upstream reads the body; reject declared oversize bodies up front.
	@too_large_upload {
		path_regexp ^/api/v1/orgs/[^/]+/investigations/[^/]+/evidence$
		expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > {$CADDY_EVIDENCE_MAX}`
	}
	@too_large {
		not path_regexp ^/api/v1/orgs/[^/]+/investigations/[^/]+/evidence$
		expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 1048576`
	}
	# Mutually exclusive handle blocks; named-matcher blocks keep file order, so these run first.
	# Same {"error": {...}} envelope the API uses.
	handle @too_large_upload {
		header Content-Type application/json
		respond `{"error":{"code":"payload_too_large","message":"Request body too large"}}` 413
	}
	handle @too_large {
		header Content-Type application/json
		respond `{"error":{"code":"payload_too_large","message":"Request body too large"}}` 413
	}

	handle @evidence_upload {
		request_body {
			max_size {$CADDY_EVIDENCE_MAX}
		}
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /api/* {
		request_body {
			max_size 1MiB
		}
		reverse_proxy api:8000
	}

	handle {
		request_body {
			max_size 1MiB
		}
		reverse_proxy web:3000
	}
}
