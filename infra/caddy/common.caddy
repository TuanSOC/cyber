# Security headers. `?` only sets a header when the upstream did not (the API's download
# responses keep their own `Content-Security-Policy: sandbox`). 'unsafe-inline' is needed by
# the Next.js App Router without nonces; a strict nonce-based CSP is planned for M2.
(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
		-X-Powered-By
	}
}

# Prod only (TLS): browsers must keep using HTTPS for this host.
(hsts) {
	header Strict-Transport-Security "max-age=31536000"
}

(csp_prod) {
	header ?Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
}

# Dev only: React needs eval for debug stacks; Turbopack HMR uses a websocket.
(csp_dev) {
	header ?Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
}

(cyberlab_routes) {
	# Evidence upload is the only route allowed a large body; everything else is capped at 1 MB.
	@evidence_upload {
		method POST
		path_regexp ^/api/v1/orgs/[^/]+/investigations/[^/]+/evidence$
	}

	# max_size only trips when the upstream reads the body; reject declared oversize bodies up front.
	@too_large_upload {
		path_regexp ^/api/v1/orgs/[^/]+/investigations/[^/]+/evidence$
		expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > {$CADDY_EVIDENCE_MAX}`
	}
	@too_large {
		not path_regexp ^/api/v1/orgs/[^/]+/investigations/[^/]+/evidence$
		expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 1048576`
	}
	# Mutually exclusive handle blocks; named-matcher blocks keep file order, so these run first.
	# Same {"error": {...}} envelope the API uses.
	handle @too_large_upload {
		header Content-Type application/json
		respond `{"error":{"code":"payload_too_large","message":"Request body too large"}}` 413
	}
	handle @too_large {
		header Content-Type application/json
		respond `{"error":{"code":"payload_too_large","message":"Request body too large"}}` 413
	}

	handle @evidence_upload {
		request_body {
			max_size {$CADDY_EVIDENCE_MAX}
		}
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /api/* {
		request_body {
			max_size 1MiB
		}
		reverse_proxy api:8000
	}

	handle {
		request_body {
			max_size 1MiB
		}
		reverse_proxy web:3000
	}
}
