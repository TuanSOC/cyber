# Test-only signatures for the synthetic dataset (production uses the ET Open snapshot).
alert http any any -> any any (msg:"CYBERLAB TEST curl user agent"; http.user_agent; content:"curl/"; startswith; sid:9000001; rev:1;)
alert http any any -> any any (msg:"CYBERLAB TEST beacon check-in"; http.uri; content:"/api/checkin"; sid:9000002; rev:1;)
