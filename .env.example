# CyberLab AI — copy to .env and replace every "change-me" value.
# Compose reads this file for variable interpolation only; each service
# receives just the variables listed in docker-compose.yml.

ENV=dev
COOKIE_SECURE=false

# --- Postgres (postgres service + init script) ---
POSTGRES_PASSWORD=change-me-superuser
POSTGRES_OWNER_PASSWORD=change-me-owner
POSTGRES_APP_PASSWORD=change-me-app

# --- API runtime (app role only; never the owner) ---
DATABASE_URL=postgresql+asyncpg://cyberlab_app:change-me-app@postgres:5432/cyberlab
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-at-least-32-characters-long-secret
MAX_EVIDENCE_BYTES=2147483648
EVIDENCE_LOCK_DAYS=30
UPLOAD_TMP_DIR=/var/lib/cyberlab/upload-tmp
MAX_CONCURRENT_UPLOADS_PER_USER=2
RATE_LIMIT_LOGIN_PER_IP_PER_MIN=20
RATE_LIMIT_LOGIN_FAILURES_PER_15MIN=5
RATE_LIMIT_REGISTER_PER_IP_PER_10MIN=5

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=evidence
MINIO_TEST_BUCKET=evidence-test
# Scoped API user (created by minio-init, no governance bypass)
MINIO_ACCESS_KEY=cyberlab-api
MINIO_SECRET_KEY=change-me-minio-api
# Root credentials: only minio + minio-init services
MINIO_ROOT_USER=cyberlab-root
MINIO_ROOT_PASSWORD=change-me-minio-root

# --- Analysis jobs ---
# Broker: separate Redis instance with ACL users (passwords must be URL-safe).
BROKER_API_PASSWORD=change-me-broker-api
BROKER_INGEST_PASSWORD=change-me-broker-ingest
BROKER_PCAP_PASSWORD=change-me-broker-pcap
BROKER_STATIC_PASSWORD=change-me-broker-static
# Threat-intel enrich worker (M4): may only touch the enrich* broker keys
BROKER_ENRICH_PASSWORD=change-me-broker-enrich
RESULTS_BUCKET=analysis-results
RESULTS_TEST_BUCKET=analysis-results-test
PCAP_MAX_BYTES=536870912
ANALYSIS_TIMEOUT_S=900
ANALYSIS_TOOL_TIMEOUT_S=600
MAX_ACTIVE_ANALYSES_PER_ORG=5
# Static analysis (M3): largest sample analyzed; every other upload up to this size gets an AV scan
STATIC_MAX_BYTES=67108864

# --- Storage (M3) ---
# Default per-org quota (evidence bytes, archived included); per-org override is set by an operator
DEFAULT_STORAGE_QUOTA_BYTES=21474836480
MAX_OWNED_ORGS_PER_USER=5

# --- Threat intelligence (M4) ---
TI_ENABLED=true
# Dev-only seal key pair, committed so a fresh clone starts (private half:
# infra/ti/dev-seal-private.json). The API only gets the public key; `dev-` kids are
# refused when ENV=prod.
TI_SEAL_ACTIVE_KID=dev-1
TI_SEAL_PUBLIC_KEYS='{"dev-1":"yzkMNEv4XawVLz1SuyMqEqSDdzMc1QpC7ERo9zFe7Gs="}'
# Prod override only: generate with scripts/gen_ti_seal_keys.py (writes
# .secrets/ti_seal_private.json, mounted into the prod enrich-worker) and paste its lines:
# TI_PROD_SEAL_ACTIVE_KID=prod-YYYYMMDD
# TI_PROD_SEAL_PUBLIC_KEYS='{"prod-YYYYMMDD":"<base64 public key>"}'
# Local `ti-mock` sink for dev/test/e2e (refused in prod)
TI_MOCK_ENABLED=true
# The key ti-mock accepts (enter it on the Test provider card in dev)
TI_MOCK_EXPECTED_KEY=change-me-ti-mock-key
# Other TI settings keep their defaults because compose does not pass them: TI_MISP_ALLOWED_PORTS,
# TI_MISP_CA_FILE, TI_MAX_IOCS_PER_RUN (200), TI_MAX_LOOKUP_VALUES (20), TI_RUN_DEADLINE_S (1800),
# TI_SLICE_S (20), TI_CEILINGS and the dev-only TI_MISP_ALLOW_PRIVATE / TI_MISP_INSECURE_TLS.
# See docs/THREAT_INTEL.md and docs/DEPLOYMENT.md.

# --- AI analyst (M5) ---
# Broker user of the analyst worker: may only touch the analyst* broker keys. The dev compose
# file falls back to a change-me default for an older .env; the prod overlay requires it.
BROKER_ANALYST_PASSWORD=change-me-broker-analyst
AI_ENABLED=true
# Dev-only AI seal key pair, committed so a fresh clone starts (private half:
# infra/ai/dev-seal-private.json, mounted into the analyst worker only). The API only gets
# the public key; `dev-` kids and this public key are refused when ENV=prod.
AI_SEAL_ACTIVE_KID=dev-ai-1
AI_SEAL_PUBLIC_KEYS='{"dev-ai-1":"YqrtDS8h4Q5PCQ0wa+0X7Qy72jDi3HYjQfotX+oH6io="}'
# Prod override only: generate with scripts/gen_ai_seal_keys.py (writes
# .secrets/ai_seal_private.json, mounted into the prod analyst-worker) and paste its lines:
# AI_PROD_SEAL_ACTIVE_KID=prod-ai-YYYYMMDD
# AI_PROD_SEAL_PUBLIC_KEYS='{"prod-ai-YYYYMMDD":"<base64 public key>"}'
# Local `ai-mock` sink for dev/test/e2e (refused in prod) and the key it accepts
AI_MOCK_ENABLED=true
AI_MOCK_EXPECTED_KEY=change-me-ai-mock-key
# Gemini runs only with paid-tier billing (and each org's paid-tier attestation)
GEMINI_BILLING_ENABLED=false
# Dev-only platform key (docker-compose.ai-platform.yml overlay, .secrets/ai_platform_key):
# AI_PLATFORM_PROVIDER=anthropic
# Anthropic effort (low, medium, high, xhigh, max); passed to the analyst worker
# AI_ANTHROPIC_EFFORT=medium
# Other AI settings keep their defaults because compose does not pass them: AI_DEFAULT_PROVIDER
# (anthropic), AI_MAX_INPUT_TOKENS
# (60000), AI_MAX_OUTPUT_TOKENS (16000), AI_CALL_TIMEOUT_S (300), AI_CALL_IDLE_TIMEOUT_S (60),
# AI_MAX_CALLS_PER_RUN (3), AI_RUN_DEADLINE_S (1200), AI_INCIDENT_DEADLINE_S (3600),
# AI_MAX_JOBS_PER_INCIDENT (10), AI_CEILINGS, AI_PLATFORM_DAILY_TOKENS (200000),
# AI_RUNS_PER_USER_10MIN (10), AI_ACTIVE_RUNS_PER_ORG (12), AI_ACTIVE_RUNS_GLOBAL (40).
# See docs/AI_ANALYST.md and docs/DEPLOYMENT.md.

# --- Reports and case management (M6) ---
# Broker user of the report renderer: may only touch the report* broker keys. The dev compose
# file falls back to a change-me default for an older .env; the prod overlay requires it.
BROKER_REPORT_PASSWORD=change-me-broker-report
# Object-locked report buckets (no default retention; per-object GOVERNANCE retention).
REPORTS_BUCKET=reports
REPORTS_TEST_BUCKET=reports-test
# Origin printed in front of the citation appendix paths of internal reports (https in prod)
# PUBLIC_BASE_URL=https://localhost:8443
# Dev-only signing pair, committed so a fresh clone starts (private half:
# infra/reports/dev-signing-private.json, mounted into the api only). `dev-` kids and this
# public key are refused when ENV=prod.
REPORT_SIGNING_ACTIVE_KID=dev-report-1
REPORT_SIGNING_PUBLIC_KEYS='{"dev-report-1":"zS2iP9napZDeshJwfCiTwYl8amzPuWJEJwHK8CpnF2k="}'
# Prod override only: generate with scripts/gen_report_signing_keys.py (writes
# .secrets/report_signing_private.json, mounted into the prod api) and paste its lines:
# REPORT_PROD_SIGNING_ACTIVE_KID=prod-report-YYYYMMDD
# REPORT_PROD_SIGNING_PUBLIC_KEYS='{"prod-report-YYYYMMDD":"<base64 public key>"}'
# Other report settings keep their defaults because compose does not pass them:
# REPORT_MAX_SNAPSHOT_BYTES (8 MiB), REPORT_MAX_ARTIFACT_BYTES (32 MiB),
# REPORT_MAX_RENDER_UNITS (450000, calibrated: worst case 594 MiB of 768, <= 214 pages), REPORT_MAX_PAGES (300),
# REPORT_RENDER_DEADLINE_S (600), REPORT_RENDER_TIMEOUT_S (120), REPORT_RENDERS_PER_USER_10MIN
# (20), REPORT_FINALIZE_PER_USER_10MIN (10), REPORT_PREVIEW_PER_USER_10MIN (30),
# REPORT_ACTIVE_RENDERS_PER_ORG (2), REPORT_ACTIVE_RENDERS_GLOBAL (4, per renderer replica),
# TIMELINE_EXPORT_MAX_ROWS (50000). See docs/REPORTS.md and docs/DEPLOYMENT.md (Reports).

# --- Platform operations (M7) ---
# Retention worker: its DB role (created by the db-bootstrap service), broker user and MinIO
# purge user. The dev compose file falls back to change-me defaults; the prod overlay
# requires real values (passwords must be URL-safe).
POSTGRES_RETENTION_PASSWORD=change-me-retention
BROKER_RETENTION_PASSWORD=change-me-broker-retention
MINIO_PURGE_ACCESS_KEY=cyberlab-purge
MINIO_PURGE_SECRET_KEY=change-me-minio-purge
# A lowered retention value, turning enforce on and a hold release wait this long (RT1)
RETENTION_POLICY_DELAY_DAYS=7

# --- Memory forensics (M8) ---
# The memory analyzer's broker user (the dev compose file falls back to a change-me default;
# the prod overlay requires a real, URL-safe value).
BROKER_MEMORY_PASSWORD=change-me-broker-memory
# Largest memory image an upload with ?kind=memory accepts (8 GiB; at most 16 GiB, RT14).
# Caddy's read_body 30m needs >= 4.6 MB/s sustained for 8 GiB (>= 9.2 MB/s for 16 GiB); the
# disk holds about twice the image while uploading and analysing (docs/DEPLOYMENT.md).
MEMORY_MAX_BYTES=8589934592
# A memory run: whole job / one plugin (seconds); active memory jobs per org / platform-wide.
ANALYSIS_MEMORY_TIMEOUT_S=5400
ANALYSIS_MEMORY_PLUGIN_TIMEOUT_S=1200
MEMORY_MAX_ACTIVE_PER_ORG=1
MEMORY_MAX_ACTIVE_TOTAL=2
# Global per-user API request limit (per minute)
RATE_LIMIT_USER_PER_MIN=600
# SSE-S3 at rest: MinIO's KMS key is a compose secret, `<name>:<base64 32 bytes>`. Dev uses the
# committed infra/minio/dev-kms-key (name cyberlab-dev-kms, refused in prod). It also encrypts
# MinIO's IAM and config: keep an encrypted backup of the prod key, a different key cannot
# read the store. Never change the key of an existing volume. `pnpm verify:prod` shares the dev
# MinIO volume (one compose project): run it with COMPOSE_PROJECT_NAME=cyberlab-clean while
# the dev and prod keys differ (docs/DEPLOYMENT.md). Prod: generate it once and keep it out of git:
#   python -c "import os,base64;print('cyberlab-kms-1:'+base64.b64encode(os.urandom(32)).decode())" > .secrets/minio_kms_key
# MINIO_SSE_ENABLED=false skips the bucket default encryption (minio-init).
# MINIO_SSE_ENABLED=true
# Object store image switch (decision pending; the bitnami default is unpatched: CVE-2025-62506,
# SN-2026-015/016). Recommended: MINIO_IMAGE=pgsty/silo@sha256:<digest> with MINIO_DATA_DIR=/data
# after a backup and the restore drill (docs/DEPLOYMENT.md, Object-store image). Defaults:
# MINIO_IMAGE=bitnamilegacy/minio:2025.5.24
# MC_IMAGE=bitnamilegacy/minio-client:2025.5.21
# MINIO_DATA_DIR=/bitnami/minio/data
# /internal/metrics bearer token (api only; dev default: an empty file = endpoint off). Create
# one and point the dev stack at it to scrape; prod reads .secrets/metrics_token:
#   python -c "import secrets;print(secrets.token_urlsafe(32))" > .secrets/metrics_token
# METRICS_TOKEN_SECRET_FILE=./.secrets/metrics_token
# Other M7 settings keep their defaults because compose does not pass them:
# RETENTION_BATCH_ROWS (5000), RETENTION_BATCH_OBJECTS (200), RETENTION_RUN_SLICE_S (120),
# RETENTION_SAMPLE_LIMIT (50), RETENTION_JOB_OUTCOMES_DAYS (90), CORRELATION_COMMON_KEY_JOBS
# (50), CORRELATION_MAX_KEYS_PER_JOB (20000), CORRELATION_INDEX_BUDGET_S (10),
# CORRELATION_INDEX_BATCH_JOBS (5), SEARCH_MIN_QUERY_CHARS (2), SEARCH_MAX_QUERY_CHARS (256),
# SEARCH_HITS_PER_TYPE (20), SEARCH_STATEMENT_TIMEOUT_S (3), SEARCH_PER_USER_PER_MIN (30),
# EVIDENCE_VIEW_AUDIT_DEDUPE_S (900). Backups (pnpm backup) go to BACKUP_DIR (./backups/,
# gitignored). A backup is TLP:RED (all evidence, hashes, sealed keys) and holds no secret:
# back up this .env and .secrets/ separately, encrypted (docs/DEPLOYMENT.md).
# BACKUP_DIR=./backups

# --- Migrations (migrate service + api-test only) ---
MIGRATION_DATABASE_URL=postgresql+asyncpg://cyberlab_owner:change-me-owner@postgres:5432/cyberlab

# --- Tests (api-test profile only) ---
TEST_DATABASE_URL=postgresql+asyncpg://cyberlab_app:change-me-app@postgres:5432/cyberlab_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://cyberlab_owner:change-me-owner@postgres:5432/cyberlab_test
TEST_REDIS_URL=redis://redis:6379/1
# Broker db of the test-profile workers and api-test (parallel lanes use 2..7, each with its
# own TEST_DATABASE_URL / TEST_MIGRATION_DATABASE_URL database and TEST_REDIS_URL db)
TEST_BROKER_DB=1

# --- Gateway ---
# max(MAX_EVIDENCE_BYTES, MEMORY_MAX_BYTES) + 1 MiB of slack for the upload route (M8: the
# memory cap is the larger one; the API still enforces each kind's own limit).
CADDY_EVIDENCE_MAX=8590983168
# Prod override only (tls internal = locally trusted cert)
SITE_ADDRESS=localhost:8443
